# =
#  МОДЕЛЬ — сейчас: DeepSeek V4 Flash (API, дёшево)
#  Проект понимает любой OpenAI-совместимый API.
# =
DEEPSEEK_API_KEY=ваш_ключ_модели
# База и модель подставляются автоматически:
#   https://api.deepseek.com  +  deepseek-v4-flash
# При желании можно переопределить:
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TEMPERATURE=

# --- Резерв: Kimi / Moonshot (выключен) ---
# MOONSHOT_API_KEY=
# KIMI_BASE_URL=
# KIMI_MODEL=

# --- Будущее: локальный DeepSeek V4 Flash через llama.cpp ---
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# =
#  LEVEL.TRAVEL — только сам токен, без «Token token=
# =
LEVEL_TRAVEL_API_KEY=ваш_токен_партнёра
LEVEL_TRAVEL_API_VERSION=

# Сайт компании — на него ведут все ссылки на отели и кнопки бронирования
TOTUS_SITE_URL=

# Страны, куда мы НЕ возим (ISO-коды через запятую).
# По умолчанию: Франция, Испания, Греция, Италия. Оставьте пустым, чтобы разрешить все.
# TOTUS_EXCLUDED_COUNTRIES=

PORT=

# Тотус клуб — плейсхолдеры системного промпта
TOTUS_AGENT_NAME=
TOTUS_COMPANY_PHONE=
TOTUS_PROMO_INFO=
TOTUS_DEPARTURE_CITIES=

# =
#  БРОНИРОВАНИЕ ЧЕРЕЗ ВАШУ ПЛАТФОРМУ
#  Шаблон ссылки, куда ведут кнопки «Перейти к бронированию».
#  Плейсхолдеры: {tour_id} {hotel_id} {room}
#  Пока не задан — кнопки ведут на внутреннюю страницу тура.
# =
# TOTUS_BOOKING_URL_TEMPLATE=
