# =
#  МОДЕЛЬ — сейчас: DeepSeek V4 Flash (API, дёшево)
#  Проект понимает любой OpenAI-совместимый API.
# =
DEEPSEEK_API_KEY=ваш_ключ_модели
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TEMPERATURE=

# =
#  LEVEL.TRAVEL
# =
LEVEL_TRAVEL_API_KEY=ваш_токен_партнёра
LEVEL_TRAVEL_API_VERSION=

TOTUS_SITE_URL=https://totus.club
# Таймаут одного запроса к Level.Travel, мс (по умолчанию 25000)
# LEVEL_TRAVEL_TIMEOUT_MS=

# =
#  ПОИСК В ИНТЕРНЕТЕ — последний шаг, когда об отеле нет сведений
#  ни в описании, ни в отзывах (Yandex Search API, Yandex Cloud).
#  Пусто — шаг просто пропускается, клиент ничего не замечает.
# =
# YANDEX_SEARCH_API_KEY=
# YANDEX_SEARCH_FOLDER_ID=

# Страны, куда мы НЕ возим (ISO-коды через запятую).
# TOTUS_EXCLUDED_COUNTRIES=

# =
#  API (apiv2.totus.club) — порт 3011
# =
PORT=3011
# Origins allowed to call the API / WS from the browser
CORS_ORIGINS=http://localhost:3000,http://localhost:3012,https://ai.totus.club,https://totus.club,https://www.totus.club

# =
#  AUTH (SECURITY_JWT_PLAN_RU.md, волна 4)
#  JWT_SECRET — ТОТ ЖЕ, что в /home/kedam_API/.env (totus_API): один эмитент токенов.
#  Нужен для истории чатов (/api/ai-chats*), staff-доступа к /api/logs, /api/debug, /api/schema
#  и для сопоставления WebSocket-сессии с пользователем (?token= в /ws/assistant).
# =
JWT_SECRET=
# log (по умолчанию) — запросы к staff-маршрутам без токена пропускаются с логом [AUTH];
# enforce — 401/403.
AUTH_MODE=log
# 1 (по умолчанию) — /ws/assistant открыт гостям без токена (ai.totus.club не передаёт токен);
# 0 — только с токеном (в log-режиме гости всё равно проходят, но пишутся в лог).
AI_GUEST_ACCESS=1

# История чатов в MySQL (та же база kedam, таблица ai_chats)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=kedam

# Тотус клуб — плейсхолдеры системного промпта
TOTUS_AGENT_NAME=
TOTUS_COMPANY_PHONE=
TOTUS_PROMO_INFO=
TOTUS_DEPARTURE_CITIES=

# TOTUS_BOOKING_URL_TEMPLATE=

# =
#  FRONT (ai.totus.club) — порт 3012
#  Local: leave API/WS empty to use Next rewrites → localhost:3011
#  Production: point at the API subdomain
# =
# BACKEND_URL=http://localhost:3011
# NEXT_PUBLIC_API_URL=https://apiv2.totus.club/api
# NEXT_PUBLIC_WS_URL=wss://apiv2.totus.club/ws/assistant
