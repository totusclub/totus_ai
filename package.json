{
  "name": "@tosmedia/ai-assistant",
  "version": "1.0.21",
  "description": "Totus AI assistant UI (Маша) — embeddable React components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css",
      "import": "./dist/styles.css",
      "require": "./dist/styles.css",
      "style": "./dist/styles.css"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tosmedia/totus_ai_v2.git",
    "directory": "packages/ai-assistant"
  },
  "license": "UNLICENSED"
}
