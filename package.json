{
  "name": "totus-ai-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:assistant",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run dev:web\"",
    "dev:web": "next dev -p 3012",
    "server": "tsx server/index.ts",
    "build": "npm run build:assistant && next build",
    "build:assistant": "npm run build -w @tosmedia/ai-assistant",
    "build:web": "next build",
    "start": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run start:web\"",
    "start:web": "next start -p 3012",
    "start:api": "npm run server",
    "publish:assistant": "npm publish -w @tosmedia/ai-assistant",
    "publish:assistant:git": "bash scripts/publish-ai-assistant-git.sh",
    "lint": "oxlint",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.3",
    "@tosmedia/ai-assistant": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "next": "^15.5.2",
    "openai": "^6.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  }
}
